# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Test dependencies, installed with `pip install --target .testlibs` (see tests/README.md).
# They are a local copy of MCDR and pytest, not part of the plugin.
.testlibs/

# Build output
dist/
*.mcdr
*.pyz

# Anything a developer points at their own server
server/
logs/
config/

# A personal access token, if one is kept in the repository rather than in ~/.workbuddy.
# ``tools/publish.py`` and ``tools/release.py`` both look here, and their docstrings claimed this
# entry existed long before it did — so anyone who followed those instructions and put a token in
# ``.secrets/gh_token`` had it sitting untracked-but-not-ignored, one ``git add -A`` away from
# being pushed. Kept as a directory pattern so a stray editor backup is covered too.
.secrets/
